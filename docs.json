{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PoseTracker",
  "description": "PoseTracker docs — WebView (iframe URL) to test in minutes, npm SDKs to ship on React Native, Expo, and web, or the MCP connector so Claude or Cursor writes the integration after you click Allow. On-device MoveNet, free keypoints, optional exercise engine.",
  "colors": {
    "primary": "#FFC300",
    "light": "#FFD54A",
    "dark": "#010A73"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "appearance": {
    "default": "system"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "PoseTracker Docs",
      "twitter:card": "summary_large_image"
    },
    "organization": {
      "name": "PoseTracker",
      "legalName": "Movelytics",
      "url": "https://www.posetracker.com",
      "logo": "https://docs.posetracker.com/logo/light.png",
      "sameAs": [
        "https://www.posetracker.com",
        "https://github.com/Movelytics",
        "https://github.com/Movelytics/react-native-pose-estimation",
        "https://github.com/Movelytics/react-native-pose-estimation-light",
        "https://github.com/Movelytics/pose-estimation-web",
        "https://github.com/Movelytics/pose-estimation-web-react",
        "https://www.npmjs.com/org/pose-tracker",
        "https://www.npmjs.com/package/@pose-tracker/react-native-pose-estimation",
        "https://www.npmjs.com/package/@pose-tracker/react-native-pose-estimation-light",
        "https://www.npmjs.com/package/@pose-tracker/pose-estimation-web",
        "https://www.npmjs.com/package/@pose-tracker/pose-estimation-web-react"
      ]
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Start here",
        "icon": "house",
        "pages": [
          "index",
          "choose-integration"
        ]
      },
      {
        "group": "WebView integration",
        "icon": "browser",
        "pages": [
          "webview/quickstart",
          "webview/query-params",
          "webview/messages",
          "webview/upload",
          "webview/reference-movement",
          "webview/embed"
        ]
      },
      {
        "group": "SDK integration",
        "icon": "cube",
        "pages": [
          "try-expo-go",
          "quickstart",
          "choose-package",
          "web-sdks",
          "permissions",
          "media-sources",
          "keypoints",
          "api-key"
        ]
      },
      {
        "group": "Reference",
        "icon": "book",
        "pages": [
          "reference/provider-client",
          "reference/webview-pose-view",
          "reference/exercises",
          "reference/physical-tests",
          "reference/events",
          "reference/features-plans"
        ]
      },
      {
        "group": "Advanced (SDK)",
        "icon": "bolt",
        "pages": [
          "advanced/preload",
          "advanced/adaptive-quality"
        ]
      },
      {
        "group": "AI & agents",
        "icon": "robot",
        "pages": [
          "llms",
          "ai/mcp-connector"
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search WebView params, SDK APIs, exercises…"
  },
  "metadata": {
    "timestamp": true
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.posetracker.com"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/org/pose-tracker"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/Movelytics/react-native-pose-estimation"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://www.posetracker.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Movelytics/react-native-pose-estimation"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "redirects": [
    {
      "source": "/reference/engine-v4",
      "destination": "/webview/query-params"
    }
  ]
}
