{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PoseTracker",
  "description": "PoseTracker React Native SDK docs — pose estimation for iOS and Android (Expo Go). Offline (~9.9 MB) and light (~206 kB) packages, free keypoints, optional exercise engine.",
  "colors": {
    "primary": "#FFC300",
    "light": "#FFD54A",
    "dark": "#010A73"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "appearance": {
    "default": "system"
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.posetracker.com",
      "og:site_name": "PoseTracker Docs"
    },
    "organization": {
      "name": "PoseTracker",
      "legalName": "Movelytics",
      "url": "https://www.posetracker.com",
      "logo": "https://docs.posetracker.com/logo/light.png",
      "sameAs": [
        "https://www.posetracker.com",
        "https://github.com/Movelytics",
        "https://github.com/Movelytics/react-native-pose-estimation",
        "https://github.com/Movelytics/react-native-pose-estimation-light",
        "https://www.npmjs.com/org/pose-tracker",
        "https://www.npmjs.com/package/@pose-tracker/react-native-pose-estimation",
        "https://www.npmjs.com/package/@pose-tracker/react-native-pose-estimation-light"
      ]
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "choose-package"
        ]
      },
      {
        "group": "Integrate",
        "pages": [
          "permissions",
          "keypoints",
          "api-key"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/provider-client",
          "reference/webview-pose-view",
          "reference/exercises",
          "reference/events",
          "reference/features-plans"
        ]
      },
      {
        "group": "Advanced",
        "pages": [
          "advanced/preload",
          "advanced/adaptive-quality"
        ]
      },
      {
        "group": "AI & agents",
        "pages": [
          "llms"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.posetracker.com"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/org/pose-tracker"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/Movelytics"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Movelytics"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  }
}
